# New AutoMotive chart style (converted from the old design.pkl)
lines.linewidth: 5
lines.linestyle: -
figure.figsize: 12, 9
figure.autolayout: True
axes.labelsize: 18
axes.titlesize: 20
axes.labelweight: normal
axes.linewidth: 0.8
axes.grid: True
axes.spines.bottom: False
axes.spines.left: False
axes.spines.right: False
axes.spines.top: False
axes.prop_cycle: cycler('color', ['416FF4', 'E06760', 'ff7f0e', '2ca02c', 'd62728', '9467bd', '8c564b', 'e377c2', '7f7f7f', 'bcbd22', '17becf'])
grid.linewidth: 1.3
legend.fontsize: 15
legend.loc: center
legend.fancybox: False
legend.frameon: False
xtick.labelsize: 15
ytick.labelsize: 15
font.family: monospace
font.monospace: Terminal, Andale Mono, DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, Courier, monospace
savefig.bbox: standard
