# New AutoMotive chart style (from the old design.pkl, revised Oct 2026)
#
# Kept: brand blue and coral as the first two series, monospace type, no spines.
# Changed: 2px lines (were 5px) and a hairline grid (was 1.3px). Slots 3-6 are now a
# colour-blind-checked set; the old orange/green pair was indistinguishable for protanopes.
# Order validated with the dataviz palette checker on a white surface:
#   416FF4 E06760 eda100 1baf7a 8a5cd6 008300
# Slots 3-4 (yellow, aqua) are below 3:1 contrast, so charts must label lines directly.

lines.linewidth: 2
lines.solid_capstyle: round
lines.markersize: 7
figure.figsize: 10, 6
figure.dpi: 110
figure.facecolor: white
figure.autolayout: True
savefig.dpi: 200
savefig.facecolor: white
axes.facecolor: white
axes.labelsize: 12
axes.titlesize: 14
axes.titlelocation: left
axes.titlepad: 12
axes.labelcolor: 52514e
axes.labelweight: normal
axes.linewidth: 0.8
axes.edgecolor: d4d3cf
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.spines.bottom: True
axes.spines.left: False
axes.spines.right: False
axes.spines.top: False
axes.prop_cycle: cycler('color', ['416FF4', 'E06760', 'eda100', '1baf7a', '8a5cd6', '008300'])
grid.color: ebeae6
grid.linewidth: 0.8
grid.linestyle: -
legend.fontsize: 10
legend.loc: best
legend.fancybox: False
legend.frameon: False
xtick.labelsize: 10
ytick.labelsize: 10
xtick.color: 52514e
ytick.color: 52514e
xtick.major.size: 0
ytick.major.size: 0
text.color: 0b0b0b
font.family: monospace
font.monospace: Terminal, Andale Mono, DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, Courier, monospace
font.size: 10
